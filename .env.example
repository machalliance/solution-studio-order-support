# Model provider. The chat agent runs on Claude (Anthropic), so this key is required.
ANTHROPIC_API_KEY=
# Also used by `npm run agent:seed` (apps/agent/src/lib/image-edit.ts) to synthesize a
# customer's "damage photo" for the seeded escalation scenarios that ask for one — an
# image-edit call on the real product photo, real money, skipped gracefully if unset.
OPENAI_API_KEY=

# The chat agent's model (free text, not a fixed dropdown). Falls back to a sane default
# if unset. Everything in this app runs on this one chat model — there is no second model.
WISMO_CHAT_MODEL=

# apps/agent
AGENT_PORT=3006
AGENT_DB_URL=file:./mastra.db   # docker-compose.yml overrides this so the database lives in the agent-data volume

# Who is who in the demo. All three are REQUIRED — the code ships with no names, and the
# agent will not start without them. Use any names you like (they appear in the chat, the
# Escalation Desk, and the stubbed notification emails).
#   - the single "logged in" customer the storefront starts with, and the address the stubbed
#     emails say they were sent to
WISMO_DEMO_CUSTOMER_NAME=John Smith
WISMO_DEMO_CUSTOMER_EMAIL=john.smith@example.com
#   - the support rep shown as logged in at the top of the Escalation Desk (no real login)
WISMO_REP_NAME=John Doe

# ISO 4217 currency code — every threshold below, every order amount, and every refund is
# denominated in this. apps/agent/src/lib/money.ts's formatMoney() (Intl.NumberFormat) is
# the only place a number should ever become a currency string; changing this one value is
# meant to be the whole fix for a different market, never a find-and-replace for a "$".
WISMO_CUR=USD

# Business-configurable values, not code. Sensible
# defaults apply if left unset. The two response-window values below are also live-adjustable
# from the Escalation Desk's Settings page (apps/agent/src/mastra/runtime-settings.ts).
# What decides a case — the return window, the return refund ceilings, the autonomy
# switches — is not an env var: it is settings inside the active policy document, edited on
# the Escalation Desk's Policies page.
# None of these carry a currency suffix in their own name — WISMO_CUR above is the one
# place that decides what unit they're actually in.
#
# Queue sorting, not policy: an escalated refund/return above this is marked high priority
# and sorts first in the Escalation Desk queue (disputes are always high). 0 = off. Also
# live-adjustable from the Settings page ("Queue Priority").
WISMO_HIGH_PRIORITY_THRESHOLD=250
# How long a specialist has to respond to an escalated case before it auto-opens a support
# ticket (apps/agent/src/mastra/workflows/policy-review-workflow.ts's "timeout" decision).
WISMO_ESCALATION_SLA_MINUTES=5
# What the customer is told to expect once a case has escalated that far.
WISMO_SUPPORT_TICKET_CONTACT_HOURS=24

# The System Authority backstop — the one autonomy limit kept OUTSIDE the policy document:
# no automatic approval above this amount, whatever the policy says (0 = none at all). Also
# live-adjustable from the Settings page. Everything else that decides a case, including the
# autonomy on/off switches, is in the policy document (Policies page).
WISMO_MAX_AUTONOMOUS_AMOUNT=500

# apps/escalation-desk — 3005 is just the suggested default; set DESK_PORT to run it on
# something else. Docker reads this file. Running natively, the Next.js scripts read the
# SHELL, not this file, so also export it (DESK_PORT=3015 npm run desk:dev) — and keep this
# line in step, because the agent uses it to decide which browser origins to allow.
DESK_PORT=3005

# apps/storefront — 3007 is just the suggested default; set STOREFRONT_PORT to run it
# on something else. Same rule as DESK_PORT: Docker reads this file; natively, also export it.
STOREFRONT_PORT=3007

# Both frontends derive the agent's address from whatever host the browser used to
# reach THEM (localhost, a LAN IP, whatever) plus this port — so testing from a phone
# over the LAN works with zero config. NEXT_PUBLIC_AGENT_URL is an override for a
# genuinely different host; leave it unset unless you actually need that. The agent's
# CORS check mirrors this: it allows any origin on DESK_PORT/STOREFRONT_PORT above,
# not a fixed hostname list, for the same reason.
NEXT_PUBLIC_AGENT_PORT=3006
NEXT_PUBLIC_AGENT_URL=

# Testing from a phone/other device over the LAN: Next.js dev mode blocks cross-origin
# access to its own dev infrastructure (HMR, dev bundles) unless the origin is listed
# here — set to this machine's current LAN IP (find it with `hostname -I` or similar).
# Leave blank if you're only ever testing from this same machine.
DEV_LAN_HOST=

# Same idea for a public hostname the dev servers are reached through (e.g. behind a reverse
# proxy). Leave blank unless you do that.
DEV_PUBLIC_HOST=
